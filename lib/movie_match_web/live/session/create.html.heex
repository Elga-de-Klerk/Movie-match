<.page max_width="4xl">
  <.heading>Create a movie session</.heading>

  <div class="mt-10">
    <.subtext>Your name</.subtext>
    <form phx-change="update_form" class="mt-2">
      <.text_input
        name="name"
        value={@name}
        phx-change="update_name"
        placeholder="Your name" />
    </form>
  </div>

  <.subtext class="mt-10">
    Select the streaming services you want to search.
  </.subtext>

  <div class="mt-2 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <%= for service <- @services do %>
      <.service_card service={service} selected={service.id in @selected_services} />
    <% end %>
  </div>

  <.action_button phx-click="create_session" disabled={@selected_services == [] or @name == ""} class="mt-6 w-full">
    Create Session
  </.action_button>
</.page>