<.page max_width="md">
  <.panel>
    <.heading>Join a session</.heading>
    <.subtext class="mt-2">Enter the session code shared by your host.</.subtext>

    <form phx-submit="join" class="mt-6 space-y-6">
      <.text_input
        name="code"
        label="Session code"
        value={@code}
        phx-change="update_code"
        placeholder="ABC123"
        autocomplete="off"
        class="text-center text-2xl font-bold uppercase tracking-[0.4em]"
      />

      <p :if={@error} class="text-sm text-red-400"><%= @error %></p>

      <.action_button type="submit" disabled={@code == ""} class="w-full">
        Join Session
      </.action_button>
    </form>
  </.panel>
</.page>