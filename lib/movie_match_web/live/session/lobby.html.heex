<.page>
  <.session_header
    session={@session}
    is_host={@participant_id != nil}
    copied={@copied} />

  <form phx-submit="start_matching" class="mt-10">
    <.panel>
      <%= if @participant_id == nil do %>
        <.heading>Join this session</.heading>
        <.subtext class="mt-2">
          Enter your name so your movie preferences can be matched with the group.
        </.subtext>
        <.text_input
          name="name"
          value={@name}
          phx-change="update_name"
          placeholder="Your name"
          class="mt-6" />
      <% else %>
        <.heading>Ready to find a movie?</.heading>
        <.subtext class="mt-2">
          Start swiping and we'll find the movies everyone agrees on.
        </.subtext>
      <% end %>
    </.panel>

    <div class="mt-6">
        <.movie_preferences
          genres={@movie_preferences.genres}
          runtime={@movie_preferences.runtime}
          variant={:display}
        />
    </div>

    <.action_button type="submit" disabled={@name == ""} class="mt-6 w-full">
      Start Matching
    </.action_button>
  </form>
</.page>